# Copia este archivo como ".env" y completa tus propios valores.
# NUNCA subas el archivo ".env" real ni las credenciales de Google a un
# repositorio público.

# ---- Flask ----
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000

# ---- Administrador inicial (solo se crea si la base está vacía) ----
ADMIN_USUARIO=admin
ADMIN_PASSWORD=admin1234

# ---- Google Sheets ----
GOOGLE_CREDENTIALS_FILE=credentials/google_credentials.json
GOOGLE_SHEET_NAME=Sistema Asistencia
GOOGLE_SHEET_TAB_ASISTENCIAS=asistenciaa
GOOGLE_SHEET_TAB_EMPLEADOS=empleados

# ---- Horario oficial ----
HORA_ENTRADA=7
HORA_SALIDA=16
MINUTOS_ALMUERZO=60

# ---- CORS ----
# En producción, cambia "*" por el dominio/IP real desde donde llamará la app.
CORS_ORIGINS=*
